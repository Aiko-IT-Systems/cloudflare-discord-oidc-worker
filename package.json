{
  "name": "discord-oidc-worker",
  "version": "5.0.0",
  "description": "Discord OIDC Provider for Cloudflare Access powered by Cloudflare Workers with full PKCE support, role caching, and more.",
  "main": "src/index.ts",
  "scripts": {
    "start": "node scripts/run-wrangler.mjs dev",
    "deploy": "node scripts/run-wrangler.mjs deploy",
    "wrangler": "node scripts/run-wrangler.mjs",
    "cf-typegen": "node scripts/run-wrangler.mjs types worker-bindings.d.ts --include-runtime=false",
    "generate:wrangler-config": "node scripts/generate-worker-config.mjs",
    "generate:types": "npm run wrangler -- types worker-configuration.d.ts && npm run cf-typegen",
    "generate:signing-key": "node scripts/generate-signing-key.mjs",
    "setup": "node scripts/setup.mjs",
    "test": "vitest run --config vitest.config.mts",
    "test:local": "node scripts/local-access-login.mjs",
    "typecheck": "npm run generate:types && tsc --noEmit"
  },
  "author": {
    "name": "Lala Sabathil",
    "email": "aiko@aitsys.dev",
    "url": "https://github.com/Lulalaby"
  },
  "contributors": [
    {
      "name": "Erisa A",
      "email": "erisa@erisa.uk"
    }
  ],
  "bugs": {
    "email": "support@aitsys.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Aiko-IT-Systems/cloudflare-discord-oidc-worker.git"
  },
  "homepage": "https://github.com/Aiko-IT-Systems/cloudflare-discord-oidc-worker#readme",
  "license": "MIT",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/Lulalaby"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/Aiko-IT-Systems"
    },
    {
      "type": "patreon",
      "url": "https://www.patreon.com/aiko_it_systems"
    }
  ],
  "dependencies": {
    "hono": "4.13.12",
    "jose": "6.2.12",
    "wrangler": "4.147.0"
  },
  "devDependencies": {
    "cf": "1.0.0-beta.11",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
